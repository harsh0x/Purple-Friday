# ==============================================================================
# PURPLE FRIDAY - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-sample-project-123456.ap-southeast-1.aws.neon.tech/purple_friday?sslmode=require"

# NextAuth Authentication & Session
NEXTAUTH_SECRET="super-secret-random-key-at-least-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# Public Site URL (Used for origin checks & absolute URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME="purplefriday"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="sample-cloudinary-secret"

# Razorpay Payments (Indian Rupee Bulk E-Commerce)
RAZORPAY_KEY_ID="rzp_test_samplekey123"
RAZORPAY_KEY_SECRET="sample-razorpay-secret-key"
RAZORPAY_WEBHOOK_SECRET="sample-razorpay-webhook-secret"

# Resend Transactional Emails
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwx"

# Google Gemini API (For AI design assistance / preview analysis)
GEMINI_API_KEY="AIzaSySampleKey1234567890abcdef"

# Cloudflare Turnstile Anti-Bot
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAASampleSiteKey"
TURNSTILE_SECRET_KEY="0x4AAAAAAASampleSecretKey"

# Upstash Redis (Distributed Rate Limiting)
UPSTASH_REDIS_REST_URL="https://sample-app.upstash.io"
UPSTASH_REDIS_REST_TOKEN="sample-upstash-redis-token"

# Admin Initial Credentials
ADMIN_EMAIL="admin@purplefriday.in"
ADMIN_INITIAL_PASSWORD="ChangeThisPasswordInProduction123!"

