# ==============================================================================
# PURPLE FRIDAY - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# All secrets must be filled in your hosting environment (Vercel / Coolify / AWS).
# Never commit actual production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Neon / Supabase PostgreSQL)
# DATABASE_URL: Pooled connection string used by Next.js at runtime
# DIRECT_URL: Direct non-pooled connection string used by Prisma for migrations
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-sample-project-pooler.ap-southeast-1.aws.neon.tech/purple_friday?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-sample-project.ap-southeast-1.aws.neon.tech/purple_friday?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & ADMIN SESSIONS
# Generate with: openssl rand -base64 32
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET="super-secret-random-key-at-least-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_JWT_SECRET="admin-secret-random-key-at-least-32-characters-long"

# ------------------------------------------------------------------------------
# 3. SITE ORIGIN & DOMAIN (Used for strict CSRF/Origin enforcement)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. BACKGROUND SCHEDULER (Cron Tick)
# Used to authenticate scheduled jobs calling /api/cron/tick every 10 minutes.
# Set Authorization header in cron runner: Bearer <CRON_SECRET>
# ------------------------------------------------------------------------------
CRON_SECRET="generate-a-secure-cron-random-secret-token"

# ------------------------------------------------------------------------------
# 6. SHIPROCKET INDIAN LOGISTICS & COURIER DISPATCH
# Get from: https://app.shiprocket.in/api-user
# ------------------------------------------------------------------------------
SHIPROCKET_API_USER="logistics@purplefriday.in"
SHIPROCKET_PASSWORD="YourShiprocketAccountPassword123"
SHIPPING_WEBHOOK_SECRET="sample-shiprocket-webhook-secret-token"

# ------------------------------------------------------------------------------
# 7. RESEND TRANSACTIONAL EMAILS
# Get from: https://resend.com/api-keys
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwx"
EMAIL_FROM="Purple Friday <orders@purplefriday.in>"
OTP_SECRET="generate-a-secure-random-otp-secret-key-at-least-32-chars"
# Set DEV_OTP_LOG=true ONLY in development for printing OTPs to console.
# In production, startup fails if DEV_OTP_LOG is true.
DEV_OTP_LOG="false"

# ------------------------------------------------------------------------------
# 8. WHATSAPP CLOUD API (Automated Prepress Proof & Dispatch Alerts)
# Get from: https://developers.facebook.com/apps -> WhatsApp -> API Setup
# ------------------------------------------------------------------------------
WHATSAPP_API_TOKEN="EAAxxxxxx"
WHATSAPP_PHONE_NUMBER_ID="109876543210987"

# ------------------------------------------------------------------------------
# 9. CLOUDINARY MEDIA STORAGE (Optional CDN for public assets)
# Get from: https://console.cloudinary.com/console
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="purplefriday"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="sample-cloudinary-secret"

# ------------------------------------------------------------------------------
# 10. INITIAL ADMIN CREDENTIALS (Created by seed script on first launch)
# Change password immediately after first login via /admin/settings.
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@purplefriday.in"
ADMIN_INITIAL_PASSWORD="ChangeThisPasswordInProduction123!"

# ------------------------------------------------------------------------------
# 11. DEV TEST CUSTOMER (Used for development seeding only)
# ------------------------------------------------------------------------------
DEV_TEST_EMAIL="customer@example.com"
DEV_TEST_PHONE="9876543210"

# ------------------------------------------------------------------------------
# 12. WEB PUSH NOTIFICATIONS (VAPID Keys for Admin & Customer Phone Alerts)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BMrFPc_W_xlFL_I73PXowUYBXhVHa0wHAeeibfwV7zzfhXLisJaZNqoXh2yMnSitdkLga0-CdRPBXAJG1jU6Q3o"
VAPID_PRIVATE_KEY="2MNO2VvSGhQ_CAJvcb98bvOiEEO_bo4giWEDP6YAk4A"
VAPID_SUBJECT="mailto:admin@purplefriday.in"
