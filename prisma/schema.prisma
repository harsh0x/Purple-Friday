// Prisma Schema for Purple Friday Custom Merchandise Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
  GRAPHIC_DESIGNER
  FACTORY_MANAGER
  SUPPORT_AGENT
}

enum Audience {
  TEAM
  GIFTING
  BOTH
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  ORDER_PLACED
  ARTWORK_UPLOADED
  MOCKUP_SENT
  REVISION_REQUESTED
  CUSTOMER_APPROVED
  IN_PRINTING
  QC_PASSED
  DISPATCHED
  DELIVERED
  CANCELLED
  REFUNDED
  RTO

  PENDING_PAYMENT
  PAID
  PROOF_PENDING
  PROOF_READY
  CHANGES_REQUESTED
  APPROVED
  IN_PRODUCTION
  PACKED
}

enum ProofStatus {
  PENDING
  READY
  CHANGES_REQUESTED
  APPROVED
}

enum CouponType {
  PERCENTAGE
  FLAT
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  name           String?
  phone          String?
  role           UserRole  @default(CUSTOMER)
  active         Boolean   @default(true)
  lastLogin      DateTime?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  mustChangePassword Boolean @default(false)
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders            Order[]
  designs           Design[]
  addresses         Address[]
  wishlistItems     WishlistItem[]
  reviews           Review[]
  couponRedemptions CouponRedemption[]
  auditLogs         AuditLog[]

  @@index([email])
  @@index([role])
}

model Category {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([slug])
  @@index([sortOrder])
}

model Product {
  id           String    @id @default(uuid())
  slug         String    @unique
  name         String
  shortName    String
  description  String
  badges       String[]
  specChips    String[]
  audience     Audience  @default(BOTH)
  minQty       Int       @default(5)
  qtyStep      Int       @default(1)
  isBestSeller Boolean   @default(false)
  mrp          Int
  basePrice    Int
  printAreas   Json
  printMethod  String
  sortOrder    Int       @default(0)
  active       Boolean   @default(true)
  categoryId   String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category      Category        @relation(fields: [categoryId], references: [id])
  options       ProductOption[]
  priceTiers    PriceTier[]
  images        ProductImage[]
  reviews       Review[]
  orderItems    OrderItem[]
  designs       Design[]
  wishlistItems WishlistItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([isBestSeller])
  @@index([sortOrder])
  @@index([active])
}

model ProductOption {
  id         String   @id @default(uuid())
  productId  String
  name       String
  type       String // COLOUR, FABRIC, SHAPE, SIZE
  value      String
  hex        String?
  image      String?
  priceDelta Int      @default(0)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([type])
}

model PriceTier {
  id        String @id @default(uuid())
  productId String
  minQty    Int
  maxQty    Int?
  unitPrice Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([minQty])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  altText   String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Review {
  id         String       @id @default(uuid())
  productId  String
  userId     String?
  rating     Int
  title      String
  body       String
  verified   Boolean      @default(false)
  photoUrls  String[]
  status     ReviewStatus @default(PENDING)
  authorName String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([userId])
  @@index([status])
}

model Order {
  id                     String       @id @default(uuid())
  orderNumber            String       @unique
  userId                 String?
  status                 OrderStatus  @default(ORDER_PLACED)
  subtotal               Int
  discount               Int          @default(0)
  gst                    Int
  shipping               Int          @default(0)
  total                  Int
  paymentMethod          String       @default("RAZORPAY")
  paymentStatus          String       @default("PAID")
  razorpayOrderId        String?
  razorpayPaymentId      String?
  address                Json
  gstin                  String?
  trackingNumber         String?
  notes                  String?
  version                Int          @default(1)
  assignedDesignerId     String?
  cancellationReason     String?
  cancelledBy            String?
  cancelledAt            DateTime?
  approvalTokenHash      String?
  approvalTokenExpiresAt DateTime?
  mockupSentAt           DateTime?
  customerApprovedAt     DateTime?
  totalPausedDurationMs  Int          @default(0)
  pausedAt               DateTime?
  slaDueAt               DateTime?
  nudgeCount             Int          @default(0)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  user   User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items  OrderItem[]
  events OrderEvent[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([assignedDesignerId])
  @@index([approvalTokenHash])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  options     Json
  qty         Int
  unitPrice   Int
  designId    String?
  artworkUrl  String?
  mockupUrl   String?
  printMethod String?
  placement   Json?
  createdAt   DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  proof   Proof?

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String
  type      String
  status    String
  actor     String
  actorRole String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

model Job {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  runAt       DateTime
  processedAt DateTime?
  attempts    Int       @default(0)
  status      String    @default("PENDING")
  error       String?
  dedupKey    String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type])
  @@index([status])
  @@index([runAt])
}

model Design {
  id         String   @id @default(uuid())
  userId     String?
  productId  String
  previewUrl String?
  logoUrl    String?
  layers     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([productId])
}

model Proof {
  id              String      @id @default(uuid())
  orderItemId     String      @unique
  imageUrl        String
  status          ProofStatus @default(PENDING)
  customerComment String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([status])
}

model Coupon {
  id            String     @id @default(uuid())
  code          String     @unique
  type          CouponType @default(PERCENTAGE)
  value         Int
  minSubtotal   Int        @default(0)
  firstOrderOnly Boolean   @default(false)
  perUserLimit  Int        @default(1)
  expiresAt     DateTime?
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  redemptions CouponRedemption[]

  @@index([code])
  @@index([active])
}

model CouponRedemption {
  id         String   @id @default(uuid())
  couponId   String
  userId     String?
  orderId    String?
  redeemedAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([userId])
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  name       String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model BlogPost {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  excerpt         String
  content         String
  authorName      String
  publishedAt     DateTime @default(now())
  published       Boolean  @default(true)
  tags            String[]
  readTimeMinutes Int      @default(5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([published])
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String   @default("General")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([sortOrder])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model QuoteRequest {
  id           String   @id @default(uuid())
  name         String
  company      String?
  email        String
  phone        String
  productSlug  String?
  estimatedQty Int
  requirements String
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model WebhookEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique
  eventType String
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([eventId])
}

model AuditLog {
  id         String   @id @default(uuid())
  time       DateTime @default(now())
  actor      String?
  actorRole  String?
  action     String
  entityType String   @default("SYSTEM")
  entityId   String?
  before     Json?
  after      Json?
  requestId  String?
  ipHash     String?

  // Legacy mappings for backward compatibility
  userId     String?
  entity     String   @default("SYSTEM")
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([actor])
  @@index([action])
  @@index([entityType])
  @@index([time])
  @@index([createdAt])
}

model Notification {
  id         String    @id @default(uuid())
  userOrRole String    // "role:SUPER_ADMIN", "role:GRAPHIC_DESIGNER", or specific user UUID
  title      String
  body       String
  link       String?
  readTime   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userOrRole])
  @@index([readTime])
  @@index([createdAt])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([key])
}
