// Prisma Schema for Purple Friday Custom Merchandise Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
  GRAPHIC_DESIGNER
  FACTORY_MANAGER
  SUPPORT_AGENT
}

enum Audience {
  TEAM
  GIFTING
  BOTH
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  ORDER_PLACED
  ARTWORK_UPLOADED
  MOCKUP_SENT
  REVISION_REQUESTED
  CUSTOMER_APPROVED
  IN_PRINTING
  QC_PASSED
  DISPATCHED
  DELIVERED
  CANCELLED
  REFUNDED
  RTO

  PENDING_PAYMENT
  PAID
  PROOF_PENDING
  PROOF_READY
  CHANGES_REQUESTED
  APPROVED
  IN_PRODUCTION
  PACKED
}

enum ProofStatus {
  PENDING
  READY
  CHANGES_REQUESTED
  APPROVED
}

enum CouponType {
  PERCENTAGE
  FLAT
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  name           String?
  phone          String?
  role           UserRole  @default(CUSTOMER)
  active         Boolean   @default(true)
  lastLogin      DateTime?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  mustChangePassword Boolean @default(false)
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders            Order[]
  designs           Design[]
  addresses         Address[]
  wishlistItems     WishlistItem[]
  reviews           Review[]
  couponRedemptions CouponRedemption[]
  auditLogs         AuditLog[]

  @@index([email])
  @@index([role])
}

model Category {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([slug])
  @@index([sortOrder])
}

model Product {
  id           String    @id @default(uuid())
  slug         String    @unique
  name         String
  shortName    String
  description  String
  badges       String[]
  specChips    String[]
  audience     Audience  @default(BOTH)
  minQty       Int       @default(5)
  qtyStep      Int       @default(1)
  isBestSeller Boolean   @default(false)
  mrp          Int
  basePrice    Int
  printAreas   Json
  printMethod  String
  sortOrder    Int       @default(0)
  active       Boolean   @default(true)
  archived     Boolean   @default(false)
  gstRate      Float     @default(0.18)
  seoTitle     String?
  seoDescription String?
  costPrice    Int       @default(0) // COGS: blank item + printing cost per piece, in paise
  version      Int       @default(1) // Optimistic locking
  categoryId   String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category      Category        @relation(fields: [categoryId], references: [id])
  options       ProductOption[]
  priceTiers    PriceTier[]
  images        ProductImage[]
  reviews       Review[]
  orderItems    OrderItem[]
  designs       Design[]
  wishlistItems WishlistItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([isBestSeller])
  @@index([sortOrder])
  @@index([active])
}

model ProductOption {
  id         String   @id @default(uuid())
  productId  String
  name       String
  type       String // COLOUR, FABRIC, SHAPE, SIZE
  value      String
  hex        String?
  image      String?
  priceDelta Int      @default(0)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([type])
}

model PriceTier {
  id        String @id @default(uuid())
  productId String
  minQty    Int
  maxQty    Int?
  unitPrice Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([minQty])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  altText   String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Review {
  id                   String       @id @default(uuid())
  productId            String
  userId               String?
  orderId              String?
  orderNumber          String?
  reviewToken          String?      @unique
  reviewTokenExpiresAt DateTime?
  rating               Int
  title                String
  body                 String
  verified             Boolean      @default(false)
  photoUrls            String[]
  status               ReviewStatus @default(PENDING)
  authorName           String
  supportTicketId      String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([userId])
  @@index([orderId])
  @@index([orderNumber])
  @@index([status])
  @@index([reviewToken])
}

model Order {
  id                     String       @id @default(uuid())
  orderNumber            String       @unique
  userId                 String?
  status                 OrderStatus  @default(ORDER_PLACED)
  subtotal               Int
  discount               Int          @default(0)
  gst                    Int
  shipping               Int          @default(0)
  total                  Int
  paymentMethod          String       @default("RAZORPAY")
  paymentStatus          String       @default("PAID")
  razorpayOrderId        String?
  razorpayPaymentId      String?
  address                Json
  gstin                  String?
  trackingNumber         String?
  notes                  String?
  version                Int          @default(1)
  assignedDesignerId     String?
  cancellationReason     String?
  cancelledBy            String?
  cancelledAt            DateTime?
  approvalTokenHash      String?
  approvalTokenExpiresAt DateTime?
  mockupSentAt           DateTime?
  customerApprovedAt     DateTime?
  totalPausedDurationMs  Int          @default(0)
  pausedAt               DateTime?
  slaDueAt               DateTime?
  nudgeCount             Int          @default(0)
  advancePaidPaise       Int          @default(0)
  balanceDuePaise        Int          @default(0)
  balanceCollectedAt     DateTime?
  balanceCollectedBy     String?
  rtoRiskScore           Int?
  rtoRiskReasons         String[]     @default([])
  rtoRiskOverrideReason  String?
  rtoRiskOverriddenBy    String?
  isPrepaidOnly          Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  events         OrderEvent[]
  shipments      Shipment[]
  refunds        Refund[]
  reviews        Review[]
  supportTickets SupportTicket[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([assignedDesignerId])
  @@index([approvalTokenHash])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  options     Json
  qty         Int
  unitPrice   Int
  designId    String?
  artworkUrl  String?
  mockupUrl   String?
  printMethod String?
  placement   Json?
  createdAt   DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  proof   Proof?

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String
  type      String
  status    String
  actor     String
  actorRole String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

model Job {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  runAt       DateTime
  processedAt DateTime?
  attempts    Int       @default(0)
  status      String    @default("PENDING")
  error       String?
  dedupKey    String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type])
  @@index([status])
  @@index([runAt])
}

model Design {
  id         String   @id @default(uuid())
  userId     String?
  productId  String
  previewUrl String?
  logoUrl    String?
  layers     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([productId])
}

model Proof {
  id              String      @id @default(uuid())
  orderItemId     String      @unique
  imageUrl        String
  status          ProofStatus @default(PENDING)
  customerComment String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([status])
}

model ProductSlugRedirect {
  id        String   @id @default(uuid())
  fromSlug  String   @unique
  toSlug    String
  createdAt DateTime @default(now())

  @@index([fromSlug])
}

model BlankSku {
  id            String          @id @default(uuid())
  sku           String          @unique // e.g. "BLANK-POLO-NAVY-M"
  name          String          // e.g. "Executive Polo, Navy, M"
  category      String          // e.g. "polo-shirts"
  color         String?
  size          String?
  stockOnHand   Int             @default(0)
  reservedQty   Int             @default(0)
  reorderLevel  Int             @default(10)
  supplierName  String          @default("Apex Merch Mills")
  leadTimeDays  Int             @default(7)
  unitCostPaise Int             @default(0) // COGS in paise
  version       Int             @default(1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  movements     StockMovement[]
  kitComponents KitComponent[]

  @@index([sku])
  @@index([category])
  @@index([stockOnHand])
}

model StockMovement {
  id           String    @id @default(uuid())
  blankSkuId   String
  changeQty    Int       // Positive (purchase/return) or negative (usage/shrinkage)
  reason       String    // PURCHASE, ORDER_RESERVATION, PRODUCTION_USE, ADJUSTMENT, RETURN, ORDER_RELEASE
  balanceAfter Int
  actor        String?
  notes        String?
  referenceId  String?   // e.g. orderId or PO number
  createdAt    DateTime  @default(now())

  blankSku BlankSku @relation(fields: [blankSkuId], references: [id], onDelete: Cascade)

  @@index([blankSkuId])
  @@index([reason])
  @@index([createdAt])
}

model Kit {
  id            String         @id @default(uuid())
  name          String         // e.g. "New Joinee Onboarding Pack"
  slug          String         @unique
  description   String?
  kitPricePaise Int            // Authoritative bundle price in paise
  active        Boolean        @default(true)
  version       Int            @default(1)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  components    KitComponent[]

  @@index([slug])
  @@index([active])
}

model KitComponent {
  id                   String    @id @default(uuid())
  kitId                String
  blankSkuId           String?
  productSku           String?   // Parent or catalog product reference
  quantity             Int       @default(1)
  substituteProductId  String?   // Optional substitute product UUID configured by admin
  substituteProductSku String?   // Human-readable substitute SKU/slug

  kit      Kit       @relation(fields: [kitId], references: [id], onDelete: Cascade)
  blankSku BlankSku? @relation(fields: [blankSkuId], references: [id], onDelete: SetNull)

  @@index([kitId])
  @@index([blankSkuId])
}

model Quote {
  id                    String    @id @default(uuid())
  quoteNumber           String    @unique // e.g. "PF-Q-2026-0001"
  customerName          String
  company               String?
  email                 String
  phone                 String
  items                 Json      // Items array with line descriptions, qty, negotiated prices, notes
  subtotalPaise         Int
  discountPaise         Int       @default(0)
  shippingPaise         Int       @default(0)
  gstPaise              Int
  totalPaise            Int
  advancePaise          Int       @default(0)
  validUntil            DateTime
  sellerGstin           String    @default("29AABCU9603R1ZM")
  buyerGstin            String?
  placeOfSupply         String    @default("Karnataka")
  hsnCode               String    @default("6109")
  status                String    @default("DRAFT") // DRAFT, SENT, ACCEPTED, EXPIRED, DECLINED
  negotiatedReason      String?   // Mandatory reason when unit price is below slab
  razorpayPaymentLinkId String?
  razorpayPaymentLinkUrl String?
  orderId               String?
  version               Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([quoteNumber])
  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model InvoiceSequence {
  id            String   @id @default("invoice_sequence")
  currentNumber Int      @default(1000)
  prefix        String   @default("INV-2026-")
  updatedAt     DateTime @updatedAt
}

model Coupon {
  id                   String     @id @default(uuid())
  code                 String     @unique
  type                 CouponType @default(PERCENTAGE)
  value                Int        // Percentage (e.g. 12) or flat paise
  maxDiscountCap       Int?       // Maximum discount cap in paise
  minSubtotal          Int        @default(0) // Minimum cart subtotal in paise
  firstOrderOnly       Boolean    @default(false)
  perUserLimit         Int        @default(1)
  totalUsageLimit      Int?       // Optional global usage quota
  usageCount           Int        @default(0)
  applicableCategories String[]   // Applicable category slugs (empty = all)
  startsAt             DateTime   @default(now())
  expiresAt            DateTime?
  active               Boolean    @default(true)
  version              Int        @default(1)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  redemptions CouponRedemption[]

  @@index([code])
  @@index([active])
}

model CouponRedemption {
  id         String   @id @default(uuid())
  couponId   String
  userId     String?
  orderId    String?
  redeemedAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([userId])
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  name       String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model BlogPost {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  excerpt         String
  content         String
  authorName      String
  publishedAt     DateTime @default(now())
  published       Boolean  @default(true)
  tags            String[]
  readTimeMinutes Int      @default(5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([published])
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String   @default("General")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([sortOrder])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model QuoteRequest {
  id           String   @id @default(uuid())
  name         String
  company      String?
  email        String
  phone        String
  productSlug  String?
  estimatedQty Int
  requirements String
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model WebhookEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique
  eventType String
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([eventId])
}

model AuditLog {
  id         String   @id @default(uuid())
  time       DateTime @default(now())
  actor      String?
  actorRole  String?
  action     String
  entityType String   @default("SYSTEM")
  entityId   String?
  before     Json?
  after      Json?
  requestId  String?
  ipHash     String?

  // Legacy mappings for backward compatibility
  userId     String?
  entity     String   @default("SYSTEM")
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([actor])
  @@index([action])
  @@index([entityType])
  @@index([time])
  @@index([createdAt])
}

model Notification {
  id         String    @id @default(uuid())
  userOrRole String    // "role:SUPER_ADMIN", "role:GRAPHIC_DESIGNER", or specific user UUID
  title      String
  body       String
  link       String?
  readTime   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userOrRole])
  @@index([readTime])
  @@index([createdAt])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([key])
}

model PinStats {
  pincode        String   @id
  deliveredCount Int      @default(0)
  rtoCount       Int      @default(0)
  totalOrders    Int      @default(0)
  rtoRate        Float    @default(0.0)
  updatedAt      DateTime @updatedAt

  @@index([pincode])
  @@index([rtoRate])
}

model Shipment {
  id                    String   @id @default(uuid())
  orderId               String
  shipmentNumber        String   @unique
  recipientName         String
  recipientPhone        String
  addressLine           String
  city                  String
  state                 String
  pincode               String
  items                 Json
  awb                   String?
  courier               String?  @default("MANUAL")
  labelUrl              String?
  status                String   @default("CREATED") // CREATED, MANIFESTED, DISPATCHED, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, RTO, CANCELLED
  trackingHistory       Json?
  collectCodAmountPaise Int      @default(0)
  weightGrams           Int      @default(500)
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([shipmentNumber])
  @@index([awb])
  @@index([status])
}

model Refund {
  id             String   @id @default(uuid())
  orderId        String
  refundNumber   String   @unique
  amountPaise    Int
  reason         String
  type           String   // RAZORPAY, MANUAL
  reference      String?  // rzp_refund_id or bank UTR
  status         String   @default("PROCESSED")
  processedBy    String
  processedRole  String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([refundNumber])
  @@index([idempotencyKey])
}

model SupportTicket {
  id            String   @id @default(uuid())
  ticketNumber  String   @unique
  orderId       String?
  orderNumber   String?
  reviewId      String?
  customerName  String
  customerEmail String
  customerPhone String?
  subject       String
  status        String   @default("OPEN") // OPEN, PENDING_CUSTOMER, RESOLVED, CLOSED
  priority      String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  assignee      String?  @default("support@purplefriday.in")
  messages      Json     // Array of { id, sender, senderRole, message, createdAt }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([ticketNumber])
  @@index([orderId])
  @@index([orderNumber])
  @@index([status])
  @@index([customerEmail])
}

model AdSpend {
  id          String   @id @default(uuid())
  date        String   @unique // "YYYY-MM-DD" or month "YYYY-MM"
  amountPaise Int      // In integer paise
  channel     String   @default("META_GOOGLE")
  notes       String?
  recordedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

model CustomerProfile {
  id                      String    @id @default(uuid())
  customerId              String    @unique
  customerEmail           String    @unique
  customerPhone           String?
  customerName            String
  companyName             String?
  firstOrderDate          DateTime?
  lastOrderDate           DateTime?
  totalOrders             Int       @default(0)
  totalSpendPaise         BigInt    @default(0)
  recencyScore            Int       @default(1) // 1 to 5
  frequencyScore          Int       @default(1) // 1 to 5
  monetaryScore           Int       @default(1) // 1 to 5
  rfmScore                String    @default("111")
  segment                 String    @default("New Customers") // VIP Corporate Buyers, One-Time Sample Buyers, At-Risk Repeat Clients, New Customers, Lapsed
  averageOrderIntervalDays Float?
  nextPredictedOrderDate  DateTime?
  lastNudgeAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([customerEmail])
  @@index([segment])
  @@index([rfmScore])
}

model ProductRecommendation {
  id                   String   @id @default(uuid())
  productId            String
  recommendedProductId String
  pairCount            Int      @default(0)
  support              Float    @default(0.0)
  confidence           Float    @default(0.0)
  lift                 Float    @default(0.0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([productId, recommendedProductId])
  @@index([productId])
  @@index([recommendedProductId])
}

model ProductSmartScore {
  id                   String   @id @default(uuid())
  productId            String   @unique
  conversionRate       Float    @default(0.0)
  profitMargin         Float    @default(0.0)
  stockHealth          Float    @default(0.0)
  reviewRating         Float    @default(0.0)
  compositeScore       Float    @default(0.0)
  normalizedComponents Json?
  boosted              Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([productId])
  @@index([compositeScore])
}

model SummaryDailyMetrics {
  date              String   @id // "YYYY-MM-DD"
  ordersCount       Int      @default(0)
  grossRevenuePaise BigInt   @default(0)
  netRevenuePaise   BigInt   @default(0)
  cogsPaise         BigInt   @default(0)
  gatewayFeesPaise  BigInt   @default(0)
  shippingCostPaise BigInt   @default(0)
  rtoLossesPaise    BigInt   @default(0)
  adSpendPaise      BigInt   @default(0)
  netMarginPaise    BigInt   @default(0)
  sampleOrdersCount Int      @default(0)
  bulkOrdersCount   Int      @default(0)
  repeatOrdersCount Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@index([date])
}

model CmsContent {
  id          String    @id @default("active") // "active" (published) or "draft"
  status      String    @default("PUBLISHED") // "DRAFT" | "PUBLISHED"
  version     Int       @default(1)
  content     Json      // Full validated CMS structure (hero, announcements, sections, faqs, footer, couponBanners, seo)
  publishedAt DateTime?
  publishedBy String?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@index([status])
}

model CmsVersion {
  id          String   @id @default(uuid())
  version     Int
  content     Json     // Snapshot of CMS structure
  publishedBy String
  publishedAt DateTime @default(now())
  note        String?

  @@index([version])
  @@index([publishedAt])
}
